# LongoUZ — muhit o'zgaruvchilari namunasi.
# Bu faylni ".env" nomiga nusxalab, haqiqiy qiymatlarni shu yerga yozing:
#   cp .env.example .env
#
# MUHIM: .env fayl HECH QACHON Git'ga (GitHub'ga) yuklanmasligi kerak —
# u .gitignore'da ro'yxatga olingan. Faqat .env.example (bo'sh namuna,
# HAQIQIY QIYMATLARSIZ) repo'da qoladi.
#
# XAVFSIZLIK HAQIDA MUHIM ESLATMA: pastdagi qiymatlar FAQAT NAMUNA
# (masalan "sizning-claude-kalitingiz-shu-yerga") — bular ISHLAMAYDIGAN,
# soxta matnlar. Haqiqiy kalitlaringizni FAQAT ".env" fayl ichida (bu
# faylda emas!) to'ldiring. ai_config.py yoki boshqa .py fayl ICHIGA
# hech qachon kalit yozmang — u yerda faqat os.getenv(...) chaqirig'i
# bo'lishi kerak, qo'shtirnoq ichida haqiqiy kalit EMAS.

# --- AI kalitlari ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Faqat "umumiy" (tashkilot) Anthropic kalitlar uchun kerak bo'lishi mumkin:
ANTHROPIC_WORKSPACE_ID=

# --- Sessiya xavfsizligi ---
# Kamida 32 baytlik TASODIFIY satr — pastdagisini ISHLATMANG, o'zingiz
# generatsiya qiling (har bir loyiha/server uchun ALOHIDA, betakror bo'lishi
# shart, aks holda foydalanuvchi sessiyalarini soxtalashtirish mumkin bo'lib
# qoladi):
#   python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=

# Productionda (haqiqiy domen + HTTPS bilan ishga tushirganda) "true" qiling,
# lokal (127.0.0.1) test qilishda "false" qoldiring:
WEB_COOKIE_SECURE=false

# Admin panel uchun parol (pastga qarang — "Markazlashtirilgan admin
# xavfsizligi" bo'limi):
ADMIN_PASSWORD=

# --- Google Sign-In (ixtiyoriy — agar sozlamasangiz, oddiy ro'yxatdan
#     o'tish/kirish ishlayveradi, faqat "Google bilan kirish" tugmasi
#     ko'rinmaydi) ---
# Olish: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Cloudflare Turnstile (ixtiyoriy — bot-himoya vidjeti) ---
# Olish: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sertifikatdagi QR kod va Google kirish qaytish manzili shu yerga bog'liq.
# 2026-10-01: server endi 0.0.0.0:2010'da (barcha tarmoq interfeyslarida)
# ishga tushadi — shu kompyuterning lokal tarmoqdagi (Wi-Fi) IP manzili
# 192.168.1.7 bo'lgani uchun shu yerga qo'yildi, shunda boshqa qurilmalar
# (telefon, boshqa kompyuter) http://192.168.1.7:2010 orqali kira oladi.
# DIQQAT: bu IP manzil router tomonidan vaqti-vaqti bilan O'ZGARISHI mumkin
# (DHCP) — agar sayt boshqa qurilmadan ochilmay qolsa, "ipconfig" buyrug'i
# bilan joriy IP'ni tekshirib, shu qatorni yangilang. Google bilan kirish
# ishlashi uchun Google Cloud Console'dagi "Authorized redirect URI" ham
# shu manzilga mos bo'lishi kerak (https://console.cloud.google.com/apis/credentials).
SITE_BASE_URL=http://localhost:6060

# Turnstile lokal tarmoqda (localhost/192.168.x.x) avtomatik o'chadi, haqiqiy domen
# yoki tunnelda yoqiladi. Lokal sinash uchun majburan yoqish: true
TURNSTILE_ENFORCE_LOCAL=false
